# VISION.TREKKING — Cloudflare Pages Headers
# Place in site/_headers for automatic deployment

# Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Cache static assets aggressively (1 year)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=3600

# HTML pages - stale-while-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root and clean URLs
/
  Cache-Control: public, max-age=0, must-revalidate

/expedicoes
  Cache-Control: public, max-age=0, must-revalidate

/sobre
  Cache-Control: public, max-age=0, must-revalidate